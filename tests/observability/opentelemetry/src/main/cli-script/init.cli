/subsystem=opentelemetry:write-attribute(name=endpoint,value="http://opentelemetrycollector:4317")
/subsystem=opentelemetry:write-attribute(name=exporter-type,value=otlp)
/subsystem=opentelemetry:write-attribute(name=batch-delay,value=1)
/subsystem=opentelemetry:write-attribute(name=max-queue-size,value=1)
/subsystem=opentelemetry:write-attribute(name=span-processor-type,value=simple)
